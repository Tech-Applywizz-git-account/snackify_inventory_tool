{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/monthly-token-grant.js": {
      "memory": 256,
      "maxDuration": 60
    },
    "api/cron/meal-booking-night-shift-report.js": {
      "memory": 256,
      "maxDuration": 60
    },
    "api/cron/schedule-night-meal-print.js": {
      "memory": 256,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/monthly-token-grant",
      "schedule": "30 2 1 * *"
    },
    {
      "path": "/api/cron/meal-booking-night-shift-report",
      "schedule": "45 18 * * *"
    },
    {
      "path": "/api/cron/schedule-night-meal-print",
      "schedule": "30 16 * * 1-5"
    }
  ]
}
